{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baselabs/bounded_authority_protocol/priv/conformance/v1/schemas/corpus-index.schema.json",
  "title": "BAP v1 portable conformance corpus index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "public_key_fingerprints",
    "files",
    "total_cases",
    "applicability"
  ],
  "properties": {
    "format": {
      "const": "bounded-authority-protocol-v1-conformance-corpus-index"
    },
    "public_key_fingerprints": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 43,
        "maxLength": 43,
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/file"}
    },
    "total_cases": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "applicability": {"$ref": "#/$defs/applicability"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256_base64url", "cases"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(cases/.+\\.(json|raw)|revision\\.json)$"
        },
        "sha256_base64url": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "cases": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "applicability": {
      "type": "object",
      "minProperties": 28,
      "maxProperties": 28,
      "required": [
        "untrusted_key_locator",
        "grant_signing_input",
        "proof_signing_input",
        "encode_consumption_entry",
        "check_chain",
        "boundary_anchor_signing_input",
        "key_transition_signing_input",
        "encode_anchored_export",
        "assemble_compact",
        "decode_grant",
        "decode_proof",
        "verify_grant",
        "verify_historical_anchor",
        "verify_key_transition",
        "verify_anchored_export",
        "check_envelope",
        "request_digest",
        "jcs.encode",
        "jwk.encode_public",
        "jwk.decode_public",
        "jwk.thumbprint_preimage",
        "jwk.thumbprint",
        "jwk.thumbprint_raw",
        "jwk.public_key_thumbprint_raw",
        "uri.normalize",
        "json.decode",
        "base64url.decode",
        "bounds.new"
      ],
      "additionalProperties": false,
      "properties": {
        "untrusted_key_locator": {"$ref": "#/$defs/class_leaves"},
        "grant_signing_input": {"$ref": "#/$defs/class_leaves"},
        "proof_signing_input": {"$ref": "#/$defs/class_leaves"},
        "encode_consumption_entry": {"$ref": "#/$defs/class_leaves"},
        "check_chain": {"$ref": "#/$defs/class_leaves"},
        "boundary_anchor_signing_input": {"$ref": "#/$defs/class_leaves"},
        "key_transition_signing_input": {"$ref": "#/$defs/class_leaves"},
        "encode_anchored_export": {"$ref": "#/$defs/class_leaves"},
        "assemble_compact": {"$ref": "#/$defs/class_leaves"},
        "decode_grant": {"$ref": "#/$defs/class_leaves"},
        "decode_proof": {"$ref": "#/$defs/class_leaves"},
        "verify_grant": {"$ref": "#/$defs/class_leaves"},
        "verify_historical_anchor": {"$ref": "#/$defs/class_leaves"},
        "verify_key_transition": {"$ref": "#/$defs/class_leaves"},
        "verify_anchored_export": {"$ref": "#/$defs/class_leaves"},
        "check_envelope": {"$ref": "#/$defs/class_leaves"},
        "request_digest": {"$ref": "#/$defs/class_leaves"},
        "jcs.encode": {"$ref": "#/$defs/class_leaves"},
        "jwk.encode_public": {"$ref": "#/$defs/class_leaves"},
        "jwk.decode_public": {"$ref": "#/$defs/class_leaves"},
        "jwk.thumbprint_preimage": {"$ref": "#/$defs/class_leaves"},
        "jwk.thumbprint": {"$ref": "#/$defs/class_leaves"},
        "jwk.thumbprint_raw": {"$ref": "#/$defs/class_leaves"},
        "jwk.public_key_thumbprint_raw": {"$ref": "#/$defs/class_leaves"},
        "uri.normalize": {"$ref": "#/$defs/class_leaves"},
        "json.decode": {"$ref": "#/$defs/class_leaves"},
        "base64url.decode": {"$ref": "#/$defs/class_leaves"},
        "bounds.new": {"$ref": "#/$defs/class_leaves"}
      }
    },
    "class_leaves": {
      "type": "object",
      "minProperties": 16,
      "maxProperties": 16,
      "required": [
        "valid",
        "boundary_near",
        "exact_bound",
        "maximum_plus_one",
        "invalid_duplicate",
        "invalid_encoding",
        "invalid_algorithm",
        "invalid_key",
        "invalid_claim",
        "invalid_time",
        "invalid_nonce",
        "invalid_uri",
        "invalid_request",
        "invalid_selector",
        "invalid_limit",
        "tamper_meaningful_byte"
      ],
      "additionalProperties": false,
      "properties": {
        "valid": {"$ref": "#/$defs/leaf"},
        "boundary_near": {"$ref": "#/$defs/leaf"},
        "exact_bound": {"$ref": "#/$defs/leaf"},
        "maximum_plus_one": {"$ref": "#/$defs/leaf"},
        "invalid_duplicate": {"$ref": "#/$defs/leaf"},
        "invalid_encoding": {"$ref": "#/$defs/leaf"},
        "invalid_algorithm": {"$ref": "#/$defs/leaf"},
        "invalid_key": {"$ref": "#/$defs/leaf"},
        "invalid_claim": {"$ref": "#/$defs/leaf"},
        "invalid_time": {"$ref": "#/$defs/leaf"},
        "invalid_nonce": {"$ref": "#/$defs/leaf"},
        "invalid_uri": {"$ref": "#/$defs/leaf"},
        "invalid_request": {"$ref": "#/$defs/leaf"},
        "invalid_selector": {"$ref": "#/$defs/leaf"},
        "invalid_limit": {"$ref": "#/$defs/leaf"},
        "tamper_meaningful_byte": {"$ref": "#/$defs/leaf"}
      }
    },
    "leaf": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"const": "n_a"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["n_a"],
          "maxProperties": 1,
          "properties": {
            "n_a": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "x-bap-maximum-utf8-bytes": 512
            }
          }
        }
      ]
    }
  }
}
