{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baselabs/bounded_authority_protocol/priv/conformance/v1/schemas/grant-payload.schema.json",
  "title": "BAP v1 grant payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "iss", "jti", "aud", "iat", "nbf", "exp", "cnf", "operations"],
  "properties": {
    "v": {"const": 1},
    "iss": {"$ref": "#/$defs/stringOrUri"},
    "jti": {"$ref": "#/$defs/stringOrUri"},
    "aud": {
      "oneOf": [
        {"$ref": "#/$defs/stringOrUri"},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stringOrUri"}
        }
      ]
    },
    "iat": {"type": "integer"},
    "nbf": {"type": "integer"},
    "exp": {"type": "integer"},
    "cnf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jkt"],
      "properties": {"jkt": {"$ref": "#/$defs/sha256"}}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "stringOrUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "x-bap-maximum-utf8-bytes": 512
    },
    "sha256": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "operationName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-bap-maximum-utf8-bytes": 128,
      "pattern": "^[ -~]+$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "selectors"],
      "properties": {
        "name": {"$ref": "#/$defs/operationName"},
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/selector"}
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "all"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "value"],
          "properties": {
            "kind": {"const": "all"},
            "path": {"$ref": "#/$defs/jsonValue"},
            "value": {"$ref": "#/$defs/jsonValue"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "values"],
          "properties": {
            "kind": {"const": "all"},
            "path": {"$ref": "#/$defs/jsonValue"},
            "values": {"$ref": "#/$defs/jsonValue"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "value"],
          "properties": {
            "kind": {"const": "equals"},
            "path": {"$ref": "#/$defs/path"},
            "value": {"$ref": "#/$defs/jsonValue"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "values"],
          "properties": {
            "kind": {"const": "one_of"},
            "path": {"$ref": "#/$defs/path"},
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {"$ref": "#/$defs/jsonValue"}
            }
          }
        }
      ]
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "x-bap-maximum-utf8-bytes": 128
      }
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "string", "maxLength": 8192, "x-bap-maximum-utf8-bytes": 8192},
        {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/jsonValue"}},
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"maxLength": 128, "x-bap-maximum-utf8-bytes": 128},
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    }
  }
}
