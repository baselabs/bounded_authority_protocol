{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baselabs/bounded_authority_protocol/priv/conformance/v1/schemas/grant-header.schema.json",
  "title": "BAP v1 protected grant header",
  "type": "object",
  "additionalProperties": false,
  "required": ["alg", "typ", "kid"],
  "properties": {
    "alg": {"const": "EdDSA"},
    "typ": {"const": "ba+cap"},
    "kid": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$"}
  }
}
