# Forge lifecycle artifacts are local; only the critical-surface declaration is tracked.
/.forge/*
!/.forge/critical-surfaces

# Built escript (regenerated by mix escript.build / conformance.verify); never tracked.
/bounded_authority_conformance

# Local `uv` residue (sdks/python): CI pins the toolchain in .github/workflows/sdks.yml
# (cryptography/ruff/mypy/pytest exact pins) and never consumes a lockfile; a tracked
# uv.lock would be a second dependency truth. The TS pnpm-lock differs: its CI installs
# FROM the lockfile, so it is tracked.
/sdks/python/uv.lock
